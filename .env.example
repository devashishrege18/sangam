# Copy to .env and fill in real values. Never commit the real .env file.

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

RIME_API_KEY=your_rime_api_key

DEEPGRAM_API_KEY=your_deepgram_api_key

# LLM provider — Google Gemini Flash (via OpenAI-compatible endpoint)
GOOGLE_API_KEY=your_google_api_key
GEMINI_MODEL=gemini-flash-lite-latest


# Twilio (used only in infra/twilio_setup.md wiring, not called directly
# from this repo's Python code — LiveKit's SIP service handles the bridge)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15550000000

